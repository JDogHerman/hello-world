<%- include('partials/head') %>
<h1>Users</h1>
<div class="card">
  <h2>Add a user</h2>
  <form method="post" action="/users" class="row">
    <label>Name <input type="text" name="name" required></label>
    <label>Email <input type="email" name="email" required></label>
    <label>Role <select name="role"><option value="steward">Steward</option><option value="admin">Admin</option></select></label>
    <label>Mobile (for alerts) <input type="tel" name="phone"></label>
    <label>Password (8+ chars) <input type="password" name="password" required minlength="8" autocomplete="new-password"></label>
    <input type="hidden" name="active" value="true">
    <div class="shrink"><button class="primary">Add</button></div>
  </form>
  <p class="muted small">Admins manage workers, lists and settings. Stewards build jobs and are the only role that can approve candidate lists.</p>
</div>
<div class="card">
  <% for (const u of users) { %>
  <form method="post" action="/users/<%= u.id %>" class="row" style="border-bottom:1px solid var(--line);padding-bottom:8px;margin-bottom:8px">
    <label>Name <input type="text" name="name" value="<%= u.name %>" required></label>
    <label>Email <input type="email" name="email" value="<%= u.email %>" required></label>
    <label>Role <select name="role"><option value="steward" <%= u.role==='steward'?'selected':'' %>>Steward</option><option value="admin" <%= u.role==='admin'?'selected':'' %>>Admin</option></select></label>
    <label>Mobile <input type="tel" name="phone" value="<%= u.phone ? h.phone(u.phone) : '' %>"></label>
    <label>New password <input type="password" name="password" minlength="8" placeholder="unchanged" autocomplete="new-password"></label>
    <div class="shrink checks"><label><input type="checkbox" name="active" <%= u.active ? 'checked' : '' %>> Active</label></div>
    <div class="shrink"><button class="small">Save</button></div>
  </form>
  <% } %>
</div>
<%- include('partials/foot') %>
