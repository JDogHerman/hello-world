{
  "name": "stagehand-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Union stagehand work-call scheduling system",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.cpSync('src/views','dist/views',{recursive:true});fs.cpSync('src/public','dist/public',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "migrate:prod": "node dist/db/migrate.js",
    "seed:reset": "tsx src/db/seed.ts --reset"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.1",
    "@fastify/session": "^11.1.6",
    "@fastify/static": "^10.1.11",
    "@fastify/view": "^12.0.1",
    "bcryptjs": "^3.0.3",
    "ejs": "^7.0.2",
    "fastify": "^5.12.8",
    "kysely": "^0.29.9",
    "libphonenumber-js": "^1.13.16",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "twilio": "^6.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
