# --- Core ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stagehand
# Used only by `npm test` (integration tests DROP and recreate its schema!)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/stagehand_test
PORT=3000
# Secret for signing session cookies (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string
# Public URL Twilio uses to reach this app. Must match the webhook URL configured
# in Twilio exactly, because it is part of the request signature.
PUBLIC_BASE_URL=http://localhost:3000

# --- SMS ---
# "console" (default, logs texts and stores them) or "twilio"
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a sending number (E.164) or a Messaging Service SID (MG...)
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Set to "false" ONLY for local testing of the webhook without signatures
TWILIO_VALIDATE_SIGNATURE=true

# --- Phone parsing ---
DEFAULT_PHONE_REGION=US
